{
  "name": "vihdutta.com",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://vihdutta.github.io",
  "scripts": {
    "dev": "vite --open",
    "dev:preview": "npm run build && vite preview --open",
    "build": "npm run content:check && tsc -b && vite build",
    "build:custom-domain": "cross-env CUSTOM_DOMAIN=true npm run build",
    "build:no-fetch": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "content:check": "tsx scripts/check-content.ts",
    "test:content": "tsx --test scripts/content.test.ts",
    "check": "npm run lint && npm run test:content && npm run build",
    "preview:custom-domain": "cross-env CUSTOM_DOMAIN=true vite preview --open"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "autoprefixer": "^10.4.21",
    "framer-motion": "^12.12.1",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.1.7",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
